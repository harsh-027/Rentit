{
  "name": "rentit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --parallel --filter ./backend --filter ./frontend dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "build": "pnpm --parallel --filter ./backend --filter ./frontend build",
    "build:frontend": "pnpm --dir frontend build",
    "build:backend": "pnpm --dir backend build",
    "backend:generate": "pnpm --dir backend generate",
    "backend:migrate": "pnpm --dir backend migrate"
  }
}
