{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --parallel --filter ./backend --filter ./frontend dev",
    "backend:dev": "pnpm --dir backend dev",
    "frontend:dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "backend:generate": "pnpm --dir backend exec prisma generate --schema prisma/schema.prisma",
    "backend:migrate": "pnpm --dir backend exec prisma migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
