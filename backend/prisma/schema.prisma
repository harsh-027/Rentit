generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  properties   Property[]
  tenants      Tenant[]
}

model Property {
  id         String        @id @default(cuid())
  userId     String
  name       String
  address    String?
  phone      String?
  currency   String        @default("INR")
  rentDueDay Int           @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rooms      Room[]
  tenants    Tenant[]
  rents      RentRecord[]
  payments   Payment[]
  history    RentHistory[]
  @@index([userId])
}

model Room {
  id          String       @id @default(cuid())
  propertyId  String
  roomNumber  String
  floor       String?
  defaultRent Decimal      @db.Decimal(12, 2)
  status      String       @default("vacant")
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenants     Tenant[]
  rents       RentRecord[]
  payments    Payment[]
  history     RentHistory[]
  @@unique([propertyId, roomNumber])
}

model Tenant {
  id              String        @id @default(cuid())
  userId          String
  propertyId      String
  roomId          String?
  name            String
  phone           String
  email           String?
  monthlyRent     Decimal       @db.Decimal(12, 2)
  securityDeposit Decimal       @default(0) @db.Decimal(12, 2)
  moveInDate      DateTime?
  moveOutDate     DateTime?
  status          String        @default("active")
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room            Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rents           RentRecord[]
  payments        Payment[]
  history         RentHistory[]
  @@index([userId, propertyId, status])
}

model RentRecord {
  id         String    @id @default(cuid())
  tenantId   String
  roomId     String?
  propertyId String
  month      Int
  year       Int
  rentAmount Decimal   @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments   Payment[]
  @@unique([tenantId, month, year])
  @@index([propertyId, year, month])
}

model Payment {
  id                   String      @id @default(cuid())
  tenantId             String
  roomId               String?
  rentRecordId         String
  propertyId           String
  amount               Decimal     @db.Decimal(12, 2)
  paymentDate          DateTime    @default(now())
  month                Int
  year                 Int
  paymentMethod        String      @default("Other")
  transactionReference String?
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room                 Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rentRecord           RentRecord  @relation(fields: [rentRecordId], references: [id], onDelete: Cascade)
  property             Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@index([propertyId, year, month])
}

model RentHistory {
  id            String    @id @default(cuid())
  tenantId      String
  roomId        String?
  propertyId    String
  previousRent  Decimal   @db.Decimal(12, 2)
  newRent       Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime
  reason        String?
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@index([tenantId, effectiveFrom])
}
